# frontend/.dockerignore
# Exclude dependencies, dev caches, and secrets from frontend Docker images

# Dependencies (installed freshly inside container)
node_modules/

# Local build output
dist/

# Secrets
.env
.env.*
!.env.example

# Tests
tests/

# Logs & temp files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
